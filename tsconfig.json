{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "jsx": "preserve",
    "types": [
      "$app/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.js",
    "test/**/*.ts",
    "test/**/*.svelte",
    "vite.config.ts"
  ],
  "exclude": [
    "tooling/**/*"
  ]
}
