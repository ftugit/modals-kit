{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "jsx": "preserve",
    "types": [
      "$app/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.js",
    "test/**/*.ts",
    "test/**/*.svelte",
    "vite.config.ts"
  ],
  "exclude": [
    "tooling/**/*",
    // Перенесённые сценарии lib/db (101 тип-ошибка: намеренно неверные входы и
    // нетипизированный JS-порт). Типизация — в чек-листе docs/audit/lib-db.md (C10-db),
    // после поиска багов lib/db. Рантайм-прогон: db-ported.test.ts в vitest.
    "src/lib/db/test/ported/**/*"
  ]
}
