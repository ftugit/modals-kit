{
  "name": "modals-kit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run && node --test tooling/*.test.mjs",
    "test:unit": "vitest run",
    "test:guard": "node --test tooling/*.test.mjs",
    "test:size": "node tooling/size-budget.mjs",
    "test:browser": "node test/browser/regressions.mjs && node test/browser/modals.mjs && node test/browser/shell.mjs && node test/browser/forms.mjs && node test/browser/forms-a11y.mjs && node test/browser/db-demo.mjs && node test/browser/fields.mjs && node test/browser/paginate.mjs && node test/browser/capabilities.mjs && node test/browser/errors.mjs",
    "test:browser:regressions": "node test/browser/regressions.mjs",
    "test:browser:modals": "node test/browser/modals.mjs",
    "test:browser:shell": "node test/browser/shell.mjs",
    "test:browser:forms": "node test/browser/forms.mjs",
    "test:browser:forms-a11y": "node test/browser/forms-a11y.mjs",
    "test:browser:fields": "node test/browser/fields.mjs",
    "test:browser:paginate": "node test/browser/paginate.mjs",
    "test:browser:db-demo": "node test/browser/db-demo.mjs",
    "test:browser:capabilities": "node test/browser/capabilities.mjs",
    "test:browser:shikimori": "node test/browser/shikimori.mjs",
    "test:browser:select-trace": "node test/browser/select-trace.mjs",
    "test:browser:errors": "node test/browser/errors.mjs",
    "test:db:probes": "node --import tsx src/lib/db/probes/pglite.probe.mts && node --import tsx src/lib/db/probes/order.probe.mts",
    "test:db": "vitest run src/lib/db"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@ark-ui/svelte": "5.24.2",
    "@electric-sql/pglite": "^0.5.8",
    "@noble/ed25519": "^3.2.0",
    "@standard-schema/spec": "^1.1.0",
    "@vercel/functions": "^3.10.1",
    "clsx": "^2.1.1",
    "esm-env": "^1.2.2",
    "pg": "^8.23.0",
    "tailwind-merge": "^3.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
